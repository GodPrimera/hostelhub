<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Create account | HostelHub</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

        :root {
            --navy: #102a43;
            --ink: #172b4d;
            --muted: #6b7a90;
            --lime: #a5f04b;
            --line: #dce6ef
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f7fafc;
            color: var(--ink);
            font-family: 'DM Sans', sans-serif
        }

        .screen {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 42% 58%
        }

        .brand {
            background: #102a43;
            color: #fff;
            padding: 42px clamp(30px, 5vw, 80px);
            position: relative;
            overflow: hidden
        }

        .brand:after {
            content: "";
            position: absolute;
            width: 540px;
            height: 540px;
            border: 70px solid #1d496d;
            border-radius: 50%;
            bottom: -330px;
            left: -230px
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;
            font: 800 20px 'Plus Jakarta Sans';
            position: relative;
            z-index: 1
        }

        .mark {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: var(--lime);
            color: var(--navy);
            font-size: 20px
        }

        .copy {
            position: relative;
            z-index: 1;
            margin-top: clamp(70px, 16vh, 165px)
        }

        .tag {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            color: var(--lime);
            font-weight: 700
        }

        .copy h1 {
            font: 800 clamp(38px, 4vw, 59px)/1.07 'Plus Jakarta Sans';
            letter-spacing: -2.6px;
            margin: 17px 0
        }

        .copy p {
            color: #c5d5e1;
            max-width: 350px;
            line-height: 1.7
        }

        .panel {
            display: flex;
            justify-content: center;
            padding: 50px 32px;
            background: linear-gradient(135deg, #fff, #f0faf5)
        }

        .form {
            width: min(100%, 520px)
        }

        h2 {
            margin: 0 0 7px;
            font: 800 31px 'Plus Jakarta Sans';
            letter-spacing: -1.4px
        }

        .sub {
            color: var(--muted);
            margin: 0 0 26px
        }

        .alert {
            padding: 12px 14px;
            margin-bottom: 16px;
            border-radius: 12px;
            background: #fff0f0;
            color: #b42318;
            font-size: 14px
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px
        }

        .field {
            margin-bottom: 15px
        }

        .full {
            grid-column: 1/-1
        }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 7px
        }

        .field input {
            height: 48px;
            width: 100%;
            border-radius: 11px;
            border: 1px solid var(--line);
            background: white;
            padding: 0 14px;
            font: 14px 'DM Sans';
            outline: none
        }

        .field input:focus {
            border-color: #44b982;
            box-shadow: 0 0 0 4px rgba(68, 185, 130, .12)
        }

        .error {
            color: #b42318;
            font-size: 12px;
            margin: 5px 0 0
        }

        .terms {
            margin: 5px 0 20px;
            display: flex;
            gap: 9px;
            font-size: 12px;
            line-height: 1.5;
            color: var(--muted)
        }

        .terms input {
            accent-color: #23895b;
            margin-top: 2px
        }

        .terms a,
        .foot a {
            color: #168257;
            text-decoration: none;
            font-weight: 700
        }

        .button {
            width: 100%;
            height: 51px;
            border: 0;
            border-radius: 12px;
            background: var(--navy);
            color: white;
            font: 700 14px 'Plus Jakarta Sans';
            cursor: pointer
        }

        .button:hover {
            background: #1a3b5b
        }

        .foot {
            text-align: center;
            color: var(--muted);
            font-size: 14px;
            margin: 22px 0
        }

        @media(max-width:780px) {
            .screen {
                grid-template-columns: 1fr
            }

            .brand {
                min-height: 250px;
                padding: 30px
            }

            .copy {
                margin-top: 55px
            }

            .copy h1 {
                font-size: 37px
            }

            .panel {
                padding: 38px 24px
            }

            .grid {
                grid-template-columns: 1fr
            }

            .full {
                grid-column: auto
            }
        }
    </style>
</head>

<body>
    <main class="screen">
        <aside class="brand">
            <div class="logo"><span class="mark">⌂</span>HostelHub</div>
            <div class="copy">
                <div class="tag">Start your workspace</div>
                <h1>Make room for better living.</h1>
                <p>Create an account to bring rooms, residents and bookings into one calm, capable system.</p>
            </div>
        </aside>
        <section class="panel">
            <div class="form">
                <h2>Create your account</h2>
                <p class="sub">Set up your HostelHub workspace in a minute.</p>
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert">
                        <%= error %>
                    </div>
                    <% } %>
                        <form action="/signup" method="post">
                            <div class="grid">
                                <div class="field full"><label for="name">Full name</label><input id="name" type="text"
                                        name="name"
                                        value="<%= typeof FormData !== 'undefined' && FormData.name ? FormData.name : '' %>"
                                        placeholder="e.g. Afata Favour Abeh" required>
                                    <% if (typeof errors !=='undefined' && errors.name) { %>
                                        <p class="error">
                                            <%= errors.name %>
                                        </p>
                                        <% } %>
                                </div>
                                <div class="field"><label for="matricule">Staff matricule</label><input id="matricule"
                                        type="text" name="matricule"
                                        value="<%= typeof FormData !== 'undefined' && FormData.matricule ? FormData.matricule : '' %>"
                                        placeholder="e.g. HST-001" required></div>
                                <div class="field"><label for="email">Work email</label><input id="email" type="email"
                                        name="email"
                                        value="<%= typeof FormData !== 'undefined' && FormData.email ? FormData.email : '' %>"
                                        placeholder="you@university.edu" required>
                                    <% if (typeof errors !=='undefined' && errors.email) { %>
                                        <p class="error">
                                            <%= errors.email %>
                                        </p>
                                        <% } %>
                                </div>
                                <div class="field"><label for="password">Password</label><input id="password"
                                        type="password" name="password" placeholder="8 or more characters" required>
                                    <% if (typeof errors !=='undefined' && errors.password) { %>
                                        <p class="error">
                                            <%= errors.password %>
                                        </p>
                                        <% } %>
                                </div>
                                <div class="field"><label for="confirmPassword">Confirm password</label><input
                                        id="confirmPassword" type="password" name="confirmPassword"
                                        placeholder="Repeat your password" required>
                                    <% if (typeof errors !=='undefined' && errors.confirmPassword) { %>
                                        <p class="error">
                                            <%= errors.confirmPassword %>
                                        </p>
                                        <% } %>
                                </div>
                            </div><label class="terms"><input type="checkbox" required><span>I agree to the <a
                                        href="#">Terms of Service</a> and <a href="#">Privacy
                                        Policy</a>.</span></label><button class="button" type="submit">Create HostelHub
                                account →</button>
                        </form>
                        <p class="foot">Already have an account? <a href="/login">Sign in</a></p>
            </div>
        </section>
    </main>
</body>

</html>