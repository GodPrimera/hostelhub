<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Sign in | HostelHub</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

        :root {
            --navy: #102a43;
            --ink: #172b4d;
            --muted: #6b7a90;
            --lime: #a5f04b;
            --line: #dce6ef
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f7fafc;
            color: var(--ink);
            font-family: 'DM Sans', sans-serif
        }

        .screen {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(360px, 45%) 1fr
        }

        .brand {
            position: relative;
            overflow: hidden;
            padding: 42px clamp(30px, 6vw, 90px);
            background: var(--navy);
            color: #fff;
            display: flex;
            flex-direction: column
        }

        .brand:before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: #1e4a71;
            right: -220px;
            bottom: -170px
        }

        .logo {
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 11px;
            font: 800 20px 'Plus Jakarta Sans'
        }

        .mark {
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: var(--lime);
            color: var(--navy);
            display: grid;
            place-items: center;
            font-size: 20px
        }

        .hero {
            z-index: 1;
            margin: auto 0
        }

        .eyebrow {
            color: var(--lime);
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 1.5px;
            text-transform: uppercase
        }

        .hero h1 {
            font: 800 clamp(40px, 4.5vw, 68px)/1.05 'Plus Jakarta Sans';
            letter-spacing: -3px;
            margin: 17px 0
        }

        .hero p {
            max-width: 440px;
            color: #cfdae5;
            font-size: 17px;
            line-height: 1.65
        }

        .stats {
            display: flex;
            gap: 28px;
            margin-top: 54px
        }

        .stats strong {
            display: block;
            font: 700 22px 'Plus Jakarta Sans'
        }

        .stats span {
            font-size: 12px;
            color: #afc2d3
        }

        .panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 42px;
            background: linear-gradient(135deg, #fff, #f2f9f7)
        }

        .form {
            width: min(100%, 430px)
        }

        h2 {
            font: 800 32px/1.2 'Plus Jakarta Sans';
            letter-spacing: -1.5px;
            margin: 0 0 8px
        }

        .intro {
            margin: 0 0 32px;
            color: var(--muted)
        }

        .alert {
            padding: 12px 14px;
            margin-bottom: 18px;
            border-radius: 12px;
            background: #fff0f0;
            color: #b42318;
            font-size: 14px
        }

        .field {
            margin-bottom: 18px
        }

        .field label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700
        }

        .input {
            position: relative
        }

        .input span {
            position: absolute;
            left: 15px;
            top: 14px;
            color: #718096
        }

        .field input {
            width: 100%;
            height: 50px;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: #fff;
            padding: 0 15px 0 43px;
            font: 14px 'DM Sans';
            outline: none
        }

        .field input:focus {
            border-color: #44b982;
            box-shadow: 0 0 0 4px rgba(68, 185, 130, .13)
        }

        .error {
            font-size: 12px;
            color: #c0392b;
            margin: 6px 0 0
        }

        .options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 3px 0 24px;
            font-size: 13px
        }

        .remember {
            display: flex;
            gap: 8px;
            align-items: center;
            color: var(--muted)
        }

        .remember input {
            accent-color: #23895b
        }

        .options a,
        .foot a {
            color: #168257;
            font-weight: 700;
            text-decoration: none
        }

        .button {
            border: 0;
            cursor: pointer;
            width: 100%;
            height: 52px;
            border-radius: 12px;
            background: var(--navy);
            color: #fff;
            font: 700 14px 'Plus Jakarta Sans';
            transition: .2s
        }

        .button:hover {
            background: #173b5e;
            transform: translateY(-1px)
        }

        .foot {
            text-align: center;
            color: var(--muted);
            font-size: 14px;
            margin-top: 26px
        }

        @media(max-width:780px) {
            .screen {
                grid-template-columns: 1fr
            }

            .brand {
                min-height: 300px;
                padding: 30px
            }

            .hero {
                margin: auto 0 0
            }

            .hero h1 {
                font-size: 39px
            }

            .stats {
                margin-top: 28px
            }

            .panel {
                padding: 40px 24px
            }
        }
    </style>
</head>

<body>
    <main class="screen">
        <section class="brand">
            <div class="logo"><span class="mark">⌂</span>HostelHub</div>
            <div class="hero">
                <div class="eyebrow">Campus living, simplified</div>
                <h1>Your hostel,<br>in perfect order.</h1>
                <p>One thoughtful workspace for managing rooms, residents and every move-in moment.</p>
                <div class="stats">
                    <div><strong>24/7</strong><span>At your service</span></div>
                    <div><strong>1 place</strong><span>For your operations</span></div>
                </div>
            </div>
        </section>
        <section class="panel">
            <div class="form">
                <h2>Welcome back</h2>
                <p class="intro">Sign in to continue to your HostelHub workspace.</p>
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert">
                        <%= error %>
                    </div>
                    <% } %>
                        <form action="/login" method="post">
                            <div class="field"><label for="email">Email address</label>
                                <div class="input"><span>✉</span><input id="email" type="email" name="email"
                                        value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                                        placeholder="you@university.edu" required></div>
                                <% if (typeof errors !=='undefined' && errors.email) { %>
                                    <p class="error">
                                        <%= errors.email %>
                                    </p>
                                    <% } %>
                            </div>
                            <div class="field"><label for="password">Password</label>
                                <div class="input"><span>⌑</span><input id="password" type="password" name="password"
                                        placeholder="Enter your password" required></div>
                                <% if (typeof errors !=='undefined' && errors.password) { %>
                                    <p class="error">
                                        <%= errors.password %>
                                    </p>
                                    <% } %>
                            </div>
                            <div class="options"><label class="remember"><input type="checkbox"> Remember me</label><a
                                    href="#">Forgot password?</a></div><button class="button" type="submit">Sign in to
                                HostelHub →</button>
                        </form>
                        <p class="foot">New to HostelHub? <a href="/signup">Create an account</a></p>
            </div>
        </section>
    </main>
</body>

</html>