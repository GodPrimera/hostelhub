<!doctype html>
<html lang="en">

<head>
    <title>Register resident | HostelHub</title><%- include('partials/admin-head') %>
</head>

<body>
    <div class="app"><%- include('partials/admin-nav',{page:'residents'}) %>
            <main class="main">
                <header class="top"><span class="crumb">Residents / <strong>Register resident</strong></span></header>
                <section class="welcome">
                    <div>
                        <% const isEdit=!!resident; %>
                        <h1>
                            <%= isEdit ? 'Edit Resident' : 'Register a resident' %>
                        </h1>
                        <p>Create the student profile before assigning a room.</p>
                    </div>
                </section>
                    <form class="card form-card"
                        action="<%= isEdit ? '/residents/' + resident._id : '/residents/new' %>" method="post">
                        <div class="head">
                            <h2>Resident details</h2><span class="badge gray">Draft</span>
                        </div>
                        <% if (typeof error !=='undefined' && error) { %>
                            <p style="color: var(--danger); margin: 0 0 16px; font-weight: 600;">
                                <%= error %>
                            </p>
                            <% } %>
                                <div class="form-grid">
                                    <div class="field"><label for="name">Full name</label><input id="name" name="name"
                                            value="<%= resident ? resident.name : (formData?.name || '') %>"
                                            placeholder="e.g. Mary N. Nfor" required></div>
                                    <div class="field"><label for="studentId">Student ID</label><input id="studentId"
                                            name="studentId"
                                            value="<%= resident ? resident.studentId : (formData?.studentId || '') %>"
                                            placeholder="e.g. UBa/26/0001" required></div>
                                    <div class="field"><label for="email">Email address</label><input id="email"
                                            name="email" type="email"
                                            value="<%= resident ? resident.email : (formData?.email || '') %>"
                                            placeholder="student@university.edu" required></div>
                                    <div class="field"><label for="phone">Phone number</label><input id="phone"
                                            name="phone" type="tel"
                                            value="<%= resident ? resident.phone : (formData?.phone || '') %>"
                                            placeholder="+237 6•• ••• •••" required></div>
                                </div>
                                <div class="form-actions"><a class="secondary" href="/residents">Cancel</a>
                                    <<button class="button" type="submit">
                                        <%= isEdit ? 'Save changes →' : 'Register resident →' %>
                                            </button>
                                </div>
                    </form>
            </main>
    </div>
</body>

</html>