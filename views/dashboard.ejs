<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Dashboard | HostelHub</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

        :root {
            --navy: #102a43;
            --ink: #17324d;
            --muted: #718096;
            --lime: #a5f04b;
            --line: #e4ebf0;
            --soft: #f6f9fb
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--soft);
            color: var(--ink);
            font-family: 'DM Sans', sans-serif
        }

        .app {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 245px 1fr
        }

        .side {
            padding: 28px 17px;
            background: #102a43;
            color: #c5d5e1;
            display: flex;
            flex-direction: column
        }

        .logo {
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 12px 44px;
            font: 800 20px 'Plus Jakarta Sans'
        }

        .mark {
            display: grid;
            place-items: center;
            width: 33px;
            height: 33px;
            border-radius: 10px;
            background: var(--lime);
            color: var(--navy);
            font-size: 19px
        }

        .label {
            margin: 0 12px 11px;
            color: #7891a7;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.3px
        }

        .nav {
            display: grid;
            gap: 5px
        }

        .nav a {
            padding: 11px 12px;
            border-radius: 10px;
            color: #c5d5e1;
            text-decoration: none;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 11px
        }

        .nav a.active,
        .nav a:hover {
            background: #1e4668;
            color: #fff
        }

        .nav b {
            font-size: 17px;
            font-weight: 400;
            width: 18px;
            text-align: center
        }

        .profile {
            margin-top: auto;
            padding: 14px 12px;
            border-top: 1px solid #294e6d;
            display: flex;
            gap: 10px;
            align-items: center
        }

        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #d9efff;
            color: #1c527e;
            display: grid;
            place-items: center;
            font-weight: 800;
            font-size: 13px
        }

        .profile strong {
            display: block;
            color: white;
            font-size: 13px
        }

        .profile span {
            font-size: 11px
        }

        .main {
            padding: 28px clamp(22px, 4vw, 60px)
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 38px
        }

        .crumb {
            color: var(--muted);
            font-size: 13px
        }

        .notice {
            font-size: 13px;
            color: #217050;
            background: #e7f7ed;
            padding: 10px 14px;
            border-radius: 9px
        }

        .welcome {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            margin-bottom: 28px
        }

        .welcome h1 {
            margin: 0;
            font: 800 clamp(28px, 3vw, 39px) 'Plus Jakarta Sans';
            letter-spacing: -1.8px
        }

        .welcome p {
            color: var(--muted);
            margin: 8px 0 0
        }

        .primary {
            border: 0;
            border-radius: 10px;
            background: var(--navy);
            color: #fff;
            padding: 13px 16px;
            font: 700 13px 'Plus Jakarta Sans'
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 29px
        }

        .metric {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 15px;
            padding: 19px
        }

        .metric-top {
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600
        }

        .icon {
            width: 30px;
            height: 30px;
            background: #eff8f3;
            border-radius: 9px;
            display: grid;
            place-items: center;
            color: #27855d
        }

        .metric strong {
            display: block;
            margin: 15px 0 4px;
            font: 800 27px 'Plus Jakarta Sans';
            letter-spacing: -1px
        }

        .metric small {
            color: #36a36f;
            font-size: 11px
        }

        .content {
            display: grid;
            grid-template-columns: 1.55fr 1fr;
            gap: 20px
        }

        .card {
            background: white;
            border: 1px solid var(--line);
            border-radius: 15px;
            padding: 22px
        }

        .head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px
        }

        .card h2 {
            font: 700 16px 'Plus Jakarta Sans';
            letter-spacing: -.4px;
            margin: 0
        }

        .link {
            color: #26865d;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none
        }

        .chart {
            height: 170px;
            display: flex;
            align-items: flex-end;
            justify-content: space-around;
            padding-top: 10px;
            border-bottom: 1px solid var(--line)
        }

        .barwrap {
            text-align: center;
            font-size: 10px;
            color: var(--muted)
        }

        .bar {
            width: 35px;
            border-radius: 7px 7px 0 0;
            background: #d8e5ee;
            margin: 0 auto 9px
        }

        .hot {
            background: linear-gradient(#a5f04b, #37b679)
        }

        .activity {
            display: grid;
            gap: 16px
        }

        .act {
            display: flex;
            gap: 11px;
            align-items: center
        }

        .acticon {
            width: 32px;
            height: 32px;
            flex: none;
            display: grid;
            place-items: center;
            border-radius: 9px;
            background: #edf8f2;
            color: #26865d
        }

        .act p {
            margin: 0;
            font-size: 13px;
            font-weight: 600
        }

        .act span {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: 11px
        }

        .actions {
            display: grid;
            gap: 10px
        }

        .action {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid var(--line);
            border-radius: 11px;
            padding: 13px;
            text-decoration: none;
            color: var(--ink);
            font-size: 13px;
            font-weight: 700
        }

        .action i {
            font-style: normal;
            color: #26865d
        }

        @media(max-width:1050px) {
            .metrics {
                grid-template-columns: repeat(2, 1fr)
            }

            .content {
                grid-template-columns: 1fr
            }
        }

        @media(max-width:680px) {
            .app {
                grid-template-columns: 1fr
            }

            .side {
                display: none
            }

            .main {
                padding: 23px 17px
            }

            .top {
                margin-bottom: 28px
            }

            .welcome {
                align-items: flex-start;
                flex-direction: column
            }

            .metrics {
                grid-template-columns: 1fr 1fr;
                gap: 10px
            }

            .metric {
                padding: 15px
            }

            .metric strong {
                font-size: 23px
            }

            .content {
                grid-template-columns: 1fr
            }

            .notice {
                display: none
            }
        }
    </style>
</head>

<body>
    <div class="app">
        <aside class="side">
            <div class="logo"><span class="mark">⌂</span>HostelHub</div>
            <p class="label">OVERVIEW</p>
            <nav class="nav"><a class="active" href="/dashboard"><b>▦</b>Dashboard</a><a href="/hostels"><b>⌂</b>Hostels</a><a
                    href="/rooms"><b>▣</b>Rooms</a><a href="/residents"><b>♙</b>Residents</a><a href="/bookings"><b>▤</b>Bookings</a></nav>
            <p class="label" style="margin-top:30px">MANAGEMENT</p>
            <nav class="nav"><a href="/reports"><b>◔</b>Reports</a><a href="/settings"><b>⚙</b>Settings</a></nav>
            <div class="profile"><span class="avatar">AF</span>
                <div><strong>Hostel Manager</strong><span>Administrator</span></div>
            </div>
        </aside>
        <main class="main">
            <header class="top"><span class="crumb">Overview / <strong>Dashboard</strong></span><span class="notice">●
                    <%= typeof message !=='undefined' && message ? message : 'All systems running smoothly' %></span>
            </header>
            <section class="welcome">
                <div>
                    <h1>Good morning, Manager.</h1>
                    <p>Here is what is happening across your hostels today.</p>
                </div><a class="primary" href="/residents/new">+ Add new resident</a>
            </section>
            <section class="metrics">
                <article class="metric">
                    <div class="metric-top"><span>Total hostels</span><span class="icon">⌂</span></div>
                    <strong><%= dashboardCard.totalHostels %></strong><small>↑ 1 added this term</small>
                </article>
                <article class="metric">
                    <div class="metric-top"><span>Available rooms</span><span class="icon">▣</span></div>
                    <strong><%= dashboardCard.hostelRooms %></strong><small>32% of all rooms</small>
                </article>
                <article class="metric">
                    <div class="metric-top"><span>Active residents</span><span class="icon">♙</span></div>
                    <strong><%= dashboardCard.totalResidents %></strong><small>↑ 8 this week</small>
                </article>
                <article class="metric">
                    <div class="metric-top"><span>Active bookings</span><span class="icon">▤</span></div>
                    <strong>1,108</strong><small>89% occupancy rate</small>
                </article>
            </section>
            <section class="content">
                <article class="card">
                    <div class="head">
                        <h2>Occupancy overview</h2><a class="link" href="/reports">View report →</a>
                    </div>
                    <div class="chart">
                        <div class="barwrap">
                            <div class="bar hot" style="height:118px"></div>Unity
                        </div>
                        <div class="barwrap">
                            <div class="bar hot" style="height:142px"></div>Harmony
                        </div>
                        <div class="barwrap">
                            <div class="bar" style="height:84px"></div>Scholar
                        </div>
                        <div class="barwrap">
                            <div class="bar hot" style="height:151px"></div>Hilltop
                        </div>
                        <div class="barwrap">
                            <div class="bar" style="height:101px"></div>Annex
                        </div>
                    </div>
                </article>
                <article class="card">
                    <div class="head">
                        <h2>Quick actions</h2>
                    </div>
                    <div class="actions"><a href="/residents/new" class="action">Register a resident <i>→</i></a><a href="/bookings/new"
                            class="action">Create a booking <i>→</i></a><a href="/rooms/new" class="action">Add a hostel room
                            <i>→</i></a></div>
                </article>
                <article class="card">
                    <div class="head">
                        <h2>Recent activity</h2><a class="link" href="#">See all</a>
                    </div>
                    <div class="activity">
                        <div class="act"><span class="acticon">+</span>
                            <div>
                                <p>New resident registered</p><span>Mary N. · 12 minutes ago</span>
                            </div>
                        </div>
                        <div class="act"><span class="acticon">✓</span>
                            <div>
                                <p>Booking confirmed</p><span>Room H-204 · 42 minutes ago</span>
                            </div>
                        </div>
                        <div class="act"><span class="acticon">⌂</span>
                            <div>
                                <p>Room marked available</p><span>Unity Hall · 1 hour ago</span>
                            </div>
                        </div>
                    </div>
                </article>
            </section>
        </main>
    </div>
</body>

</html>
