<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

    :root {
        --navy: #102a43;
        --ink: #17324d;
        --muted: #718096;
        --green: #25865d;
        --lime: #a5f04b;
        --line: #e3ebf0;
        --soft: #f6f9fb;
        --danger: #c2413b;
    }

    * {
        box-sizing: border-box
    }

    body {
        margin: 0;
        background: var(--soft);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif
    }

    .app {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 245px 1fr
    }

    .side {
        padding: 28px 17px;
        background: var(--navy);
        color: #c5d5e1;
        display: flex;
        flex-direction: column
    }

    .logo {
        color: #fff;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 12px 44px;
        font: 800 20px 'Plus Jakarta Sans'
    }

    .mark {
        display: grid;
        place-items: center;
        width: 33px;
        height: 33px;
        border-radius: 10px;
        background: var(--lime);
        color: var(--navy);
        font-size: 19px
    }

    .label {
        margin: 0 12px 11px;
        color: #7891a7;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.3px
    }

    .nav {
        display: grid;
        gap: 5px
    }

    .nav a {
        padding: 11px 12px;
        border-radius: 10px;
        color: #c5d5e1;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 11px
    }

    .nav a.active,
    .nav a:hover {
        background: #1e4668;
        color: #fff
    }

    .nav b {
        font-size: 17px;
        font-weight: 400;
        width: 18px;
        text-align: center
    }

    .profile {
        margin-top: auto;
        padding: 14px 12px;
        border-top: 1px solid #294e6d;
        display: flex;
        gap: 10px;
        align-items: center
    }

    .avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #d9efff;
        color: #1c527e;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 13px
    }

    .profile strong {
        display: block;
        color: white;
        font-size: 13px
    }

    .profile span {
        font-size: 11px
    }

    .main {
        padding: 28px clamp(22px, 4vw, 60px)
    }

    .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px
    }

    .crumb {
        color: var(--muted);
        font-size: 13px
    }

    .welcome {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 28px
    }

    .welcome h1 {
        margin: 0;
        font: 800 clamp(28px, 3vw, 38px) 'Plus Jakarta Sans';
        letter-spacing: -1.6px
    }

    .welcome p {
        color: var(--muted);
        margin: 8px 0 0
    }

    .button {
        border: 0;
        border-radius: 10px;
        background: var(--navy);
        color: #fff;
        padding: 13px 16px;
        font: 700 13px 'Plus Jakarta Sans';
        white-space: nowrap
    }

    .button.green {
        background: var(--green)
    }

    .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 15px;
        padding: 22px
    }

    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px
    }

    .head h2 {
        margin: 0;
        font: 700 16px 'Plus Jakarta Sans'
    }

    .tools {
        display: flex;
        gap: 10px;
        align-items: center
    }

    .search {
        height: 38px;
        min-width: 220px;
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 0 12px;
        font: 13px 'DM Sans';
        outline: none
    }

    .filter {
        height: 38px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: #fff;
        padding: 0 11px;
        color: var(--ink);
        font: 13px 'DM Sans'
    }

    table {
        border-collapse: collapse;
        width: 100%;
        font-size: 13px
    }

    th {
        text-align: left;
        padding: 0 12px 12px;
        color: var(--muted);
        font-size: 11px;
        letter-spacing: .3px;
        text-transform: uppercase
    }

    td {
        padding: 14px 12px;
        border-top: 1px solid var(--line)
    }

    .name {
        font-weight: 700
    }

    .sub {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 11px
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 99px;
        padding: 5px 9px;
        font-size: 11px;
        font-weight: 700;
        background: #e9f8ef;
        color: #227550
    }

    .badge.amber {
        background: #fff5dd;
        color: #9a6700
    }

    .badge.gray {
        background: #edf2f5;
        color: #5e6e7f
    }

    .dots {
        color: #718096;
        font-size: 18px;
        display: flex;
        align-items: center;
    }

    .edit {
        background-color: #b4b4b5;
        border-radius: 3px;
        padding: 2px 6px;
        border: 1px solid #6c6e70;
        color: white;
        text-decoration: none;
        font-size: 16px;
    }

    .delete {
        background-color: var(--danger);
        border: 1px;
        padding: 4px 6px;
        border-radius: 2px;
        margin-left: 4px;
        color: white;
    }

    .edit:hover {
        background-color: #6c6e70;
    }

    .delete:hover {
        background-color: #be2e2e;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px
    }

    .stat {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px
    }

    .stat span {
        color: var(--muted);
        font-size: 12px
    }

    .stat strong {
        display: block;
        font: 800 26px 'Plus Jakarta Sans';
        margin-top: 9px
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px
    }

    .tile {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 15px;
        padding: 20px
    }

    .tile-top {
        display: flex;
        justify-content: space-between
    }

    .tile-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #e8f6ee;
        color: var(--green);
        display: grid;
        place-items: center;
        font-size: 20px
    }

    .tile h2 {
        font: 700 17px 'Plus Jakarta Sans';
        margin: 18px 0 5px
    }

    .tile p {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.6;
        margin: 0
    }

    .progress {
        height: 7px;
        background: #edf2f5;
        border-radius: 20px;
        margin: 18px 0 8px;
        overflow: hidden
    }

    .progress i {
        display: block;
        height: 100%;
        border-radius: 20px;
        background: linear-gradient(90deg, #a5f04b, #39b77c)
    }

    .split {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 20px
    }

    .report {
        height: 220px;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        border-bottom: 1px solid var(--line);
        padding: 15px
    }

    .barwrap {
        text-align: center;
        color: var(--muted);
        font-size: 11px
    }

    .bar {
        width: 38px;
        background: #d8e6ee;
        border-radius: 7px 7px 0 0;
        margin: 0 auto 8px
    }

    .bar.hot {
        background: linear-gradient(#a5f04b, #37b679)
    }

    .setting {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0;
        border-top: 1px solid var(--line)
    }

    .setting:first-of-type {
        border-top: 0
    }

    .setting h3 {
        font-size: 13px;
        margin: 0
    }

    .setting p {
        font-size: 12px;
        color: var(--muted);
        margin: 4px 0 0
    }

    .switch {
        width: 39px;
        height: 23px;
        background: #d4dee6;
        border-radius: 20px;
        padding: 3px
    }

    .switch i {
        display: block;
        width: 17px;
        height: 17px;
        background: #fff;
        border-radius: 50%
    }

    .switch.on {
        background: var(--green)
    }

.switch.on i {
    margin-left: 16px
}

.form-card{max-width:850px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:13px;font-weight:700}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;background:#fff;padding:12px 13px;color:var(--ink);font:14px 'DM Sans';outline:0}.field textarea{min-height:120px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 4px rgba(37,134,93,.1)}.form-actions{display:flex;justify-content:flex-end;gap:11px;margin-top:27px}.secondary{border:1px solid var(--line);border-radius:10px;padding:12px 16px;color:var(--ink);background:#fff;text-decoration:none;font-size:13px;font-weight:700}@media(max-width:740px){.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.form-actions{justify-content:stretch}.form-actions>*{flex:1;text-align:center}}

    @media(max-width:1050px) {
        .grid {
            grid-template-columns: repeat(2, 1fr)
        }

        .split {
            grid-template-columns: 1fr
        }
    }

    @media(max-width:740px) {
        .app {
            grid-template-columns: 1fr
        }

        .side {
            display: none
        }

        .main {
            padding: 23px 17px
        }

        .welcome {
            align-items: flex-start;
            flex-direction: column
        }

        .stats,
        .grid {
            grid-template-columns: 1fr
        }

        .head {
            align-items: flex-start;
            flex-direction: column
        }

        .tools {
            width: 100%;
            flex-wrap: wrap
        }

        .search {
            min-width: 0;
            flex: 1
        }

        table {
            min-width: 650px
        }

        .table-wrap {
            overflow: auto
        }
    }
</style>
